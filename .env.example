# Copy to .env and adjust. Never commit .env.

# --- Application ---
APP_ENV=development            # development | test | production
LOG_LEVEL=INFO
LOG_JSON=false
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Database (local run; docker-compose overrides the host to "db") ---
POSTGRES_USER=expireguard
POSTGRES_PASSWORD=expireguard
POSTGRES_DB=expireguard
DATABASE_URL=postgresql+asyncpg://expireguard:expireguard@localhost:5432/expireguard
TEST_DATABASE_URL=postgresql+asyncpg://expireguard:expireguard@localhost:5432/expireguard_test

# --- Auth (generate with: python -c "import secrets; print(secrets.token_urlsafe(48))") ---
JWT_SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=60
RESET_TOKEN_EXPIRE_MINUTES=30

# --- Rate limiting (in-process; use Redis-backed limiting when running several workers) ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_UPLOAD_PER_MINUTE=5

# --- Expiry engine thresholds (days) ---
EXPIRY_CRITICAL_DAYS=30
EXPIRY_SOON_DAYS=90

# --- Inventory ---
ALLOW_NEGATIVE_INVENTORY=false
LOW_STOCK_THRESHOLD=10

# --- SMS ---
SMS_MODE=mock                  # mock | live
SMS_PROVIDER=africastalking    # africastalking | twilio (used when SMS_MODE=live)
SMS_MIN_SEVERITY=CRITICAL      # INFO | WARNING | CRITICAL | URGENT
SMS_TIMEOUT_SECONDS=10
SMS_MAX_ATTEMPTS=3
SMS_SENDER_ID=
AT_USERNAME=
AT_API_KEY=
AT_SANDBOX=true
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Imports ---
MAX_UPLOAD_SIZE_MB=10
MAX_IMPORT_ROWS=50000
IMPORT_DATE_DAYFIRST=true      # 03/04/2027 = 3 April (false = 4 March)

# --- Analytics / anomaly detection ---
ANALYTICS_DEFAULT_DAYS=30
ANOMALY_BASELINE_DAYS=28
ANOMALY_RECENT_DAYS=7
ANOMALY_Z_THRESHOLD=2.5
ANOMALY_MIN_PCT_CHANGE=50
ANOMALY_HIGH_COVER_DAYS=180
ANOMALY_LOW_COVER_DAYS=3

# --- AI intelligence layer (Phase 2) ---
# mock works with no credentials. openai/anthropic need BOTH key and model, otherwise mock is used.
AI_PROVIDER=mock               # mock | openai | anthropic
OPENAI_API_KEY=
OPENAI_MODEL=                  # e.g. a current OpenAI chat model name
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=               # e.g. a current Claude model name
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
AI_TIMEOUT_SECONDS=45
AI_MAX_TOKENS=2000
AI_TEMPERATURE=0.2
AI_CHAT_HISTORY_MESSAGES=10
AI_CONTEXT_LIST_LIMIT=10
AI_RATE_LIMIT_PER_MINUTE=20

# --- Background jobs (UTC) ---
SCHEDULER_ENABLED=true
EXPIRY_JOB_HOUR=6
EXPIRY_JOB_MINUTE=0
ALERT_JOB_INTERVAL_MINUTES=30
CLEANUP_JOB_HOUR=3
ALERT_RETENTION_DAYS=180
